{
  "manifest_version": 3,
  "name": "ScholarlyHelp MCQ Practice Scanner",
  "version": "0.1.0",
  "key": "",
  "description": "Reads the multiple-choice practice questions on your screen and explains the answers.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://api.scholarlyhelp.com/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open MCQ Practice Scanner" },
  "side_panel": { "default_path": "sidepanel.html" },
  "externally_connectable": {
    "matches": ["https://scholarlyhelp.com/*", "https://www.scholarlyhelp.com/*"]
  }
}
